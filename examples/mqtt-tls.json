{
  "type": "mqtt",
  "host": "broker.example.com",
  "port": 8883,
  "user": "vscp",
  "password": "secret",
  "tls": {
    "capath": "/etc/ssl/certs"
  },
  "subscribe": [
    { "topic": "vscp/#", "qos": 1, "format": "auto" }
